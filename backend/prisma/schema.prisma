generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?   // Added to support your frontend registration form!
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Removed the invalid `authorId` and ambiguous `users User[]` from here

  blogs     Blog[]
  likes     Like[]
  comments  Comment[]
}

model Blog {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  summary     String?   // Included from your assessment rubric!
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Kept ONLY the author relation (removed the duplicate userId relation)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes       Like[]
  comments    Comment[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  blogId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId]) // Prevents a user from liking the same post twice
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  userId    String
  blogId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([createdAt])
}